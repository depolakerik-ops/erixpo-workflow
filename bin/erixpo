#!/usr/bin/env bash
# Thin erixpo runner. Skills do the thinking; this process repeats a worker + check.
set -euo pipefail

ROOT="$(pwd)"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACK="$(cd "$HERE/.." && pwd)"
if [[ -d "$HERE/../adapters" ]]; then
  ADAPTERS="$HERE/../adapters"
elif [[ -d "$ROOT/.erixpo/adapters" ]]; then
  ADAPTERS="$ROOT/.erixpo/adapters"
elif [[ -d "$ROOT/adapters" ]]; then
  ADAPTERS="$ROOT/adapters"
else
  ADAPTERS="$HERE/../adapters"
fi

SCRIPTS=""
for cand in "$PACK/scripts" "$ROOT/.erixpo/scripts" "$ROOT/scripts" "$HERE/../scripts"; do
  if [[ -d "$cand" ]]; then
    SCRIPTS="$cand"
    break
  fi
done

MAX=20
WORKER="${ERIXPO_WORKER:-claude}"
ORDER=""
ISOLATE=1
SLUG="run"
STAGE=""
KIND="all"

usage() {
  cat <<'EOF'
Usage: bin/erixpo <command> [options]

Commands:
  run       loop worker + check until pass or --max
  check     run the project check command once
  status    print .erixpo state if present
  isolate   create a sibling git worktree + branch
  worktrees list isolated trees
  merge     merge an isolated branch into the current branch (no push)
  prune     remove an isolated worktree
  close     merge if needed, then remove worktree + branch
  sweep     report leftover trees/branches; --apply cleans safe ones
  search         search sessions / learnings / worktrees
  review         run mechanical stage-1 review (stage 2 is a different agent session)
  classify       mechanical request_class / ui_change hints for a sentence
  capabilities   print what this machine can actually run

Options for run:
  --worker NAME    claude | codex | cursor | opencode | hermes | gemini | generic
  --max N          iteration cap (default 20)
  --prompt FILE    extra prompt file (default: .erixpo/plan.md)
  --isolate        run inside a new worktree (default)
  --no-isolate     run in this checkout
  --slug NAME      worktree slug

Options for isolate / merge / prune / close / sweep:
  --slug NAME
  --id ID
  --delete-branch
  --with-env       copy .env.example only
  --keep           merge/close: keep worktree and branch
  --keep-branch    close: remove worktree, keep branch
  --no-merge       close: only if already merged or contained
  --apply          sweep: mark stale, prune, delete dead merged branches

Options for search:
  --kind all|sessions|learnings|worktrees

Options for review:
  --stage 1        mechanical only (the only stage this CLI runs)
EOF
}

resolve_script() {
  local name="$1"
  if [[ -n "$SCRIPTS" && -f "$SCRIPTS/$name" ]]; then
    printf '%s' "$SCRIPTS/$name"
    return 0
  fi
  echo "missing $name (looked in $SCRIPTS)" >&2
  return 1
}

read_check() {
  local line=""
  if [[ -f "$ROOT/.erixpo/stack.md" ]]; then
    line="$(grep -E '^check:' "$ROOT/.erixpo/stack.md" 2>/dev/null | head -1 | sed 's/^check:[[:space:]]*//' || true)"
  fi
  if [[ -z "$line" && -f "$ROOT/AGENTS.md" ]]; then
    line="$(grep -E '^check:' "$ROOT/AGENTS.md" 2>/dev/null | head -1 | sed 's/^check:[[:space:]]*//' || true)"
  fi
  if [[ -z "$line" ]]; then
    echo "write a one-line 'check: <command>' into .erixpo/stack.md" >&2
    return 1
  fi
  printf '%s' "$line"
}

write_loop_prompt() {
  local dest="$1" src="$2" iter="$3"
  {
    if [[ -f "$ROOT/templates/PROMPT.md" ]]; then
      cat "$ROOT/templates/PROMPT.md"
    elif [[ -f "$ROOT/.erixpo/pack-templates/PROMPT.md" ]]; then
      cat "$ROOT/.erixpo/pack-templates/PROMPT.md"
    elif [[ -f "$PACK/templates/PROMPT.md" ]]; then
      cat "$PACK/templates/PROMPT.md"
    else
      cat <<'INNER'
Follow erixpo-auto + quality.md + testing.md + ui.md; never ERIXPO_DONE without check in THIS iteration; never merge to main.
INNER
    fi
    echo
    echo "## Iteration $iter"
    echo
    echo "Project root: $ROOT"
    echo
    echo "## Plan"
    echo
    cat "$src"
    echo
    echo "## Classify"
    echo
    if [[ -f "$ROOT/.erixpo/classify.md" ]]; then
      cat "$ROOT/.erixpo/classify.md"
    else
      echo "MISSING .erixpo/classify.md — write it this iteration before product code. Run: bin/erixpo classify <sentence>"
    fi
    echo
    echo "## USER"
    echo
    if [[ -f "$ROOT/.erixpo/USER.md" ]]; then
      cat "$ROOT/.erixpo/USER.md"
    else
      echo "MISSING USER.md — apply defaults: autonomy plan-then-go, test harness-required, review always-stage-2."
    fi
    echo
    echo "## Capabilities (machine facts)"
    echo
    if [[ -n "$SCRIPTS" && -f "$SCRIPTS/detect-capabilities.sh" ]]; then
      bash "$SCRIPTS/detect-capabilities.sh" || true
    else
      echo "(detect-capabilities.sh not installed)"
    fi
    echo
    echo "## Contract files (read, do not paste)"
    echo
    for ref in testing.md quality.md ui.md slop.md scaffold.md ceremony.md classify.md failures.md; do
      for d in \
        "$ROOT/.agents/skills/erixpo/references" \
        "$ROOT/.claude/skills/erixpo/references" \
        "$ROOT/.cursor/skills/erixpo/references" \
        "$PACK/skills/erixpo/references"
      do
        if [[ -f "$d/$ref" ]]; then
          echo "- $d/$ref"
          break
        fi
      done
    done
    if [[ -f "$ROOT/.erixpo/lessons.md" ]]; then
      echo
      echo "## Lessons"
      echo
      cat "$ROOT/.erixpo/lessons.md"
    fi
  } > "$dest"
}

cmd="${1:-}"
shift || true

ID=""
DELETE_BRANCH=0
WITH_ENV=0
KEEP=0
KEEP_BRANCH=0
NO_MERGE=0
APPLY=0
SEARCH_Q=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --worker) WORKER="$2"; shift 2 ;;
    --max) MAX="$2"; shift 2 ;;
    --prompt) ORDER="$2"; shift 2 ;;
    --isolate) ISOLATE=1; shift ;;
    --no-isolate) ISOLATE=0; shift ;;
    --slug) SLUG="$2"; shift 2 ;;
    --id) ID="$2"; shift 2 ;;
    --delete-branch) DELETE_BRANCH=1; shift ;;
    --with-env) WITH_ENV=1; shift ;;
    --keep) KEEP=1; shift ;;
    --keep-branch) KEEP_BRANCH=1; shift ;;
    --no-merge) NO_MERGE=1; shift ;;
    --apply) APPLY=1; shift ;;
    --kind) KIND="$2"; shift 2 ;;
    --stage) STAGE="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *)
      SEARCH_Q+=("$1")
      shift
      ;;
  esac
done

case "$cmd" in
  status)
    if [[ -f "$ROOT/.erixpo/state.md" ]]; then
      cat "$ROOT/.erixpo/state.md"
    elif [[ -f "$ROOT/.erixpo/state.yaml" ]]; then
      cat "$ROOT/.erixpo/state.yaml"
    else
      echo "erixpo not initialized in $ROOT"
      exit 1
    fi
    if [[ -f "$ROOT/.erixpo/worktrees.jsonl" ]]; then
      echo
      echo "## worktrees"
      cat "$ROOT/.erixpo/worktrees.jsonl"
      python3 - "$ROOT/.erixpo/worktrees.jsonl" <<'PY' || true
import json, os, sys
path = sys.argv[1]
warn = 0
for raw in open(path, encoding="utf-8"):
    raw = raw.strip()
    if not raw:
        continue
    try:
        row = json.loads(raw)
    except json.JSONDecodeError:
        continue
    st = row.get("status") or ""
    p = row.get("path") or ""
    ident = row.get("id") or "?"
    if st in ("live", "merged") and p and os.path.isdir(p):
        print(f"WARN: worktree {ident} status={st} still on disk: {p}", file=sys.stderr)
        print(f"      bin/erixpo close --id {ident}", file=sys.stderr)
        warn += 1
    elif st == "merged":
        print(f"WARN: {ident} is merged but not closed. bin/erixpo close --id {ident}", file=sys.stderr)
        warn += 1
if warn:
    print(f"WARN: {warn} worktree(s) need close — leftover checkouts clutter the machine.", file=sys.stderr)
PY
    fi
    ;;
  classify)
    CS="$(resolve_script classify-signals.py)"
    python3 "$CS" "${SEARCH_Q[@]+"${SEARCH_Q[@]}"}"
    ;;
  capabilities)
    DC="$(resolve_script detect-capabilities.sh)"
    bash "$DC"
    ;;
  check)
    CHECK="$(read_check)"
    echo "check: $CHECK"
    bash -lc "$CHECK"
    ;;
  isolate|worktrees|merge|prune|close|sweep)
    WT="$(resolve_script worktree.sh)"
    extra=()
    [[ -n "$SLUG" && "$cmd" == isolate ]] && extra+=(--slug "$SLUG")
    [[ "$WITH_ENV" -eq 1 ]] && extra+=(--with-env)
    [[ -n "$ID" ]] && extra+=(--id "$ID")
    [[ "$DELETE_BRANCH" -eq 1 ]] && extra+=(--delete-branch)
    [[ "$KEEP" -eq 1 ]] && extra+=(--keep)
    [[ "$KEEP_BRANCH" -eq 1 ]] && extra+=(--keep-branch)
    [[ "$NO_MERGE" -eq 1 ]] && extra+=(--no-merge)
    [[ "$APPLY" -eq 1 ]] && extra+=(--apply)
    bash "$WT" "$cmd" "${extra[@]+"${extra[@]}"}"
    ;;
  search)
    SS="$(resolve_script session-search.sh)"
    bash "$SS" --root "$ROOT" --kind "$KIND" "${SEARCH_Q[@]+"${SEARCH_Q[@]}"}"
    ;;
  review)
    if [[ -n "$STAGE" && "$STAGE" != "1" ]]; then
      echo "this CLI only runs stage 1. stage 2 is a different agent session (/erixpo review)." >&2
      exit 1
    fi
    RS="$(resolve_script review-stage1.sh)"
    bash "$RS"
    ;;
  run)
    ADAPTER="$ADAPTERS/${WORKER}.sh"
    if [[ ! -x "$ADAPTER" && ! -f "$ADAPTER" ]]; then
      echo "missing adapter $ADAPTER" >&2
      exit 1
    fi
    iso_id=""
    if [[ "$ISOLATE" -eq 1 ]]; then
      WT="$(resolve_script worktree.sh)"
      iso_out="$(bash "$WT" isolate --slug "$SLUG")"
      echo "$iso_out"
      new_root="$(printf '%s\n' "$iso_out" | awk -F': ' '/^path:/{print $2; exit}')"
      iso_id="$(printf '%s\n' "$iso_out" | awk -F': ' '/^id:/{print $2; exit}')"
      if [[ -z "$new_root" || ! -d "$new_root" ]]; then
        echo "isolate did not return a usable path" >&2
        exit 1
      fi
      ROOT="$new_root"
      cd "$ROOT"
    fi
    CHECK="$(read_check)"
    PLAN_FILE="${ORDER:-$ROOT/.erixpo/plan.md}"
    if [[ ! -f "$PLAN_FILE" ]]; then
      echo "no plan at $PLAN_FILE" >&2
      exit 1
    fi
    mkdir -p "$ROOT/.erixpo"
    i=1
    while [[ "$i" -le "$MAX" ]]; do
      echo "── erixpo iteration $i / $MAX ──"
      LOOP_PROMPT="$ROOT/.erixpo/loop-prompt.md"
      write_loop_prompt "$LOOP_PROMPT" "$PLAN_FILE" "$i"
      echo "$(date -Iseconds) iteration=$i worker=$WORKER root=$ROOT" >> "$ROOT/.erixpo/loop.log"
      bash "$ADAPTER" "$ROOT" "$LOOP_PROMPT" "$i" || echo "worker exited non-zero (continuing to check)"
      echo "check: $CHECK"
      if bash -lc "$CHECK"; then
        echo "check passed on iteration $i"
        echo "$(date -Iseconds) passed iteration=$i" >> "$ROOT/.erixpo/loop.log"
        if [[ -n "$iso_id" ]]; then
          echo "next: two-stage review in this tree, then bin/erixpo close --id $iso_id from the human checkout"
        else
          echo "next: two-stage review in this tree"
        fi
        exit 0
      fi
      i=$((i + 1))
    done
    echo "budget exhausted after $MAX iterations" >&2
    exit 2
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
