#!/usr/bin/env bash
# Portable entrypoint; resolve file and directory symlinks before locating the pack.
set -euo pipefail
exec python3 - "${BASH_SOURCE[0]}" "$@" <<'PY'
import os, pathlib, sys
entry = pathlib.Path(sys.argv[1]).resolve()
script = entry.parent.parent / "scripts" / "erixpo-runtime.py"
if not script.is_file():
    sys.exit(f"erixpo runtime missing at {script}; reinstall the pack")
os.execv(sys.executable, [sys.executable, str(script), *sys.argv[2:]])
PY
